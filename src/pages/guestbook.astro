      <div class="hero-links">
        <a class="text-link" href="mailto:mail@hicancan.top">邮件 ↗</a>
        <a class="text-link" href="https://github.com/hicancan/hicancan-blog/discussions" target="_blank" rel="noopener noreferrer">GitHub Discussions ↗</a>
      </div>
    </header>
  </div>
</SiteLayout>
