---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import ProjectRow from '../components/ProjectRow.astro';

const projects = (await getCollection('projects')).sort((a, b) => (b.data.priority ?? 0) - (a.data.priority ?? 0));
---

<SiteLayout title="项目" description="hicancan 做过的项目。">
  <div class="container">
    <header class="page-intro">
      <p class="eyebrow">Projects</p>
      <h1 class="page-title">项目</h1>
      <p class="page-subtitle">从想法到能运行的东西。</p>
    </header>
    <ul class="project-list">{projects.map((project) => <ProjectRow project={project} />)}</ul>
  </div>
</SiteLayout>
