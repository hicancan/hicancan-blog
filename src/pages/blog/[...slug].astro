---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { categoryOf, formatDate } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const { Content } = await render(post);
---

<SiteLayout title={post.data.title} description={post.data.description}>
  <article class="article-wrap">
    <header class="article-header">
      <a class="back-link" href="/articles/">← 全部文章</a>
      <p class="eyebrow">{categoryOf(post)}</p>
      <h1>{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>
      <div class="article-date">
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        {post.data.updatedDate && <span>更新于 {formatDate(post.data.updatedDate)}</span>}
      </div>
    </header>
    <div class="article-content"><Content /></div>
    <div class="article-end"><a class="text-link" href="/articles/">返回全部文章 <span aria-hidden="true">↗</span></a></div>
  </article>
</SiteLayout>

<script>import '../../scripts/diagrams';</script>
