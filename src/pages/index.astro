---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import PostRow from '../components/PostRow.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { getPosts } from '../lib/content';
import avatar from '../assets/avatar.jpg';

const posts = (await getPosts()).slice(0, 4);
const projects = (await getCollection('projects'))
  .sort((a, b) => (b.data.priority ?? 0) - (a.data.priority ?? 0))
  .slice(0, 2);
---

<SiteLayout>
  <div class="container">
    <section class="home-hero" aria-labelledby="intro-title">
      <div>
        <p class="eyebrow">南京邮电大学 · 学生 / 开发者</p>
        <h1 id="intro-title" class="hero-name">你好，我是<br /><span>hicancan.</span></h1>
        <p class="hero-copy">写代码，也记录做题、研究和阅读时遇到的问题。这里放着我的文章和做过的项目。</p>
        <div class="hero-links">
          <a class="text-link" href="/articles/">读文章 <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="/about/">关于我 <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <Image src={avatar} width={190} height={190} class="hero-portrait" alt="hicancan 的头像" loading="eager" />
    </section>

    <section class="section-block" aria-labelledby="recent-title">
      <div class="section-heading"><h2 id="recent-title">最近写的</h2><a href="/articles/">全部文章 ↗</a></div>
      <ul class="post-list">{posts.map((post) => <PostRow post={post} />)}</ul>
    </section>

    <section class="section-block" aria-labelledby="projects-title">
      <div class="section-heading"><h2 id="projects-title">做过的项目</h2><a href="/projects/">全部项目 ↗</a></div>
      <ul class="project-list">{projects.map((project) => <ProjectRow project={project} />)}</ul>
    </section>
  </div>
</SiteLayout>
