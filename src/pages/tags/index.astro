---
import { getPosts } from '../../lib/content';
import SiteLayout from '../../layouts/SiteLayout.astro';

const posts = await getPosts();
const counts = new Map<string, number>();
for (const post of posts) for (const tag of post.data.tags ?? []) counts.set(tag, (counts.get(tag) ?? 0) + 1);
const tags = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<SiteLayout title="标签" description="按标签浏览文章。">
  <div class="container">
    <header class="page-intro"><p class="eyebrow">Topics</p><h1 class="page-title">标签</h1></header>
    <ul class="tag-list">{tags.map(([tag, count]) => <li><a href={'/tags/' + encodeURIComponent(tag) + '/'}>{tag} · {count}</a></li>)}</ul>
  </div>
</SiteLayout>
