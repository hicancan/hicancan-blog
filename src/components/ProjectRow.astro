---
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
---

<li>
  <a class="project-row" href={project.data.link} target="_blank" rel="noopener noreferrer">
    <div>
      <h3>{project.data.title}</h3>
      <p>{project.data.description}</p>
      <div class="project-tags" aria-label="技术标签">
        {project.data.tags.map((tag) => <span>{tag}</span>)}
      </div>
    </div>
    <span class="arrow" aria-hidden="true">↗</span>
  </a>
</li>
